func sieveOfEratosthenes(n: num) {
    var prime = [..n + 1]
    for (var i = 0; i < __size(prime); i = i + 1) {
        prime[i] = 1
    }

    for (var p = 2; p <= n; p = p + 1) {
        if (prime[p] == true) {
            for (var i = p * p; i <= n; i = i + p) {
                prime[i] = false
            }
        }
    }

    for (var i = 2; i <= n; i = i + 1) {
        if (prime[i] == true) {
            print(i)
        }
    }
}

{
    sieveOfEratosthenes(100000)
}