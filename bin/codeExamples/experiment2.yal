func red() {
    print (9 * 7 + 1)
    print("gol")
}

func test(in: num) {
    while (false or false and true) {
        print(6 * 8 + 9)
        return true
    }

    if (in > 0) {
        print((8 * 3 + 1) + in + (5 * 3))
    }

    for (var i = 8 + 7 * 8 - 7; i < 100 - 1 + (-3); i = i + 1) {
        print(i)
    }

    var prime = [..10 + 4]
    for (var i = 0; i < __size(prime); i = i + 1) {
        prime[i] = 1 + 3 + 4 + in + 5
    }

    print(in)
    for (var i = 0; i < __size(prime); i = i + 1) {
        print(prime[i])
    }
}

{
    test(34)
    red()
    print("finish")
}